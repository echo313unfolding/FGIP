.cache/
.mypy_cache/
.pytest_cache/

# Generated wiki (rebuild with make wiki-index)
wiki/

# Claude Code local config
.mcp.json
CLAUDE.md

# Private/personal financial structure (NEVER commit)
scripts/insert_entity_structure.py
receipts/entity-structure-*.json

# Accidental CLI artifacts
--no-stage
